datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum AttemptStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SessionStatus {
  OPEN
  ABANDONED
  COMPLETED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
  TRIALING
}

enum OpportunityType {
  PAYMENT_FAILURE
  REPEATED_PAYMENT_FAILURE
  CHECKOUT_ABANDONMENT
  SUBSCRIPTION_FAILURE
}

enum OpportunityStatus {
  DETECTED
  ANALYZED
  RECOMMENDED
  APPROVED
  IN_PROGRESS
  RECOVERED
  FAILED
  DISMISSED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionType {
  RETRY_PAYMENT
  RECOVER_CHECKOUT
  RETRY_SUBSCRIPTION
  CONTACT_CUSTOMER
  SEND_PAYMENT_REMINDER
  ESCALATE
  MONITOR
}

enum ActionStatus {
  PENDING
  APPROVED
  EXECUTING
  EXECUTED
  FAILED
  CANCELED
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum OutcomeType {
  SUCCESS
  PARTIAL_SUCCESS
  FAILURE
}

model Tenant {
  id                    String                @id @default(cuid())
  name                  String
  slug                  String                @unique
  
  customers             Customer[]
  orders                Order[]
  payments              Payment[]
  paymentAttempts       PaymentAttempt[]
  checkoutSessions      CheckoutSession[]
  subscriptions         Subscription[]
  recoveryOpportunities RecoveryOpportunity[]
  recoveryActions       RecoveryAction[]
  recoveryOutcomes      RecoveryOutcome[]
  webhookEvents         WebhookEvent[]
  memberships           Membership[]
  recoveryExecutions    RecoveryExecution[]
  auditEvents           AuditEvent[]
  recoveryPolicies      RecoveryPolicy[]

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

model Customer {
  id                    String                @id @default(cuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  provider              String?
  providerCustomerId    String?
  
  name                  String
  email                 String
  phone                 String?
  metadata              Json?
  
  orders                Order[]
  payments              Payment[]
  paymentAttempts       PaymentAttempt[]
  checkoutSessions      CheckoutSession[]
  subscriptions         Subscription[]
  recoveryOpportunities RecoveryOpportunity[]
  
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([tenantId, provider, providerCustomerId])
  @@index([tenantId])
  @@index([email])
}

model Order {
  id                    String                @id @default(cuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId            String
  customer              Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  provider              String?
  providerOrderId       String?
  
  amountMinor           Int
  currency              String                @default("INR")
  status                OrderStatus
  metadata              Json?
  
  payments              Payment[]
  paymentAttempts       PaymentAttempt[]
  checkoutSessions      CheckoutSession[]
  recoveryOpportunities RecoveryOpportunity[]
  
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([tenantId, provider, providerOrderId])
  @@index([tenantId])
  @@index([customerId])
  @@index([status])
}

model Payment {
  id                    String                @id @default(cuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId            String
  customer              Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId               String?
  order                 Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  
  provider              String?
  providerPaymentId     String?
  
  amountMinor           Int
  currency              String                @default("INR")
  status                PaymentStatus
  paymentMethod         Json?
  metadata              Json?
  
  capturedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  
  attempts              PaymentAttempt[]
  checkoutSessions      CheckoutSession[]
  recoveryOpportunities RecoveryOpportunity[]

  @@unique([tenantId, provider, providerPaymentId])
  @@index([tenantId])
  @@index([customerId])
  @@index([orderId])
  @@index([status])
}

model PaymentAttempt {
  id                    String                @id @default(cuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId            String
  customer              Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  paymentId             String?
  payment               Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  orderId               String?
  order                 Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  
  attemptNumber         Int
  amountMinor           Int
  currency              String                @default("INR")
  status                AttemptStatus
  failureCode           String?
  failureReason         String?
  gatewayResponse       Json?
  
  attemptedAt           DateTime              @default(now())

  @@unique([paymentId, attemptNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([paymentId])
  @@index([orderId])
  @@index([attemptedAt])
}

model CheckoutSession {
  id                         String                @id @default(cuid())
  tenantId                   String
  tenant                     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId                 String?
  customer                   Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId                    String?
  order                      Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentId                  String?
  payment                    Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  
  provider                   String?
  providerCheckoutSessionId  String?
  
  amountMinor                Int
  currency                   String                @default("INR")
  status                     SessionStatus
  
  startedAt                  DateTime              @default(now())
  abandonedAt                DateTime?
  completedAt                DateTime?
  expiresAt                  DateTime?
  metadata                   Json?
  
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  
  recoveryOpportunities      RecoveryOpportunity[]

  @@unique([tenantId, provider, providerCheckoutSessionId])
  @@index([tenantId])
  @@index([customerId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model Subscription {
  id                        String                @id @default(cuid())
  tenantId                  String
  tenant                    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId                String
  customer                  Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  provider                  String?
  providerSubscriptionId    String?
  
  planName                  String
  amountMinor               Int
  currency                  String                @default("INR")
  billingInterval           String
  status                    SubscriptionStatus
  
  nextChargeAt              DateTime?
  startedAt                 DateTime?
  endedAt                 DateTime?
  canceledAt                DateTime?
  metadata                  Json?
  
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  
  recoveryOpportunities     RecoveryOpportunity[]

  @@unique([tenantId, provider, providerSubscriptionId])
  @@index([tenantId])
  @@index([customerId])
  @@index([status])
}

model RecoveryOpportunity {
  id                    String                @id @default(cuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId            String?
  customer              Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId               String?
  order                 Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentId             String?
  payment               Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  checkoutSessionId     String?
  checkoutSession       CheckoutSession?      @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  subscriptionId        String?
  subscription          Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  
  type                  OpportunityType
  status                OpportunityStatus
  amountAtRiskMinor     Int
  recoverableAmountMinor Int
  priority              PriorityLevel
  score                 Int
  confidenceScore       Float?
  reason                String
  evidence              Json
  recommendation        Json?
  correlationKey        String?
  
  actions               RecoveryAction[]
  outcomes              RecoveryOutcome[]
  executions            RecoveryExecution[]
  auditEvents           AuditEvent[]
  
  detectedAt            DateTime              @default(now())
  resolvedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([tenantId, correlationKey])
  @@index([tenantId])
  @@index([customerId])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([correlationKey])
}

model RecoveryAction {
  id                    String                @id @default(cuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunityId         String
  opportunity           RecoveryOpportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  type                  ActionType
  status                ActionStatus
  channel               String?
  expectedRecoveryAmountMinor Int?
  notes                 String?
  failureReason         String?
  recommendationSnapshot Json?
  payload               Json?
  
  approvedAt            DateTime?
  scheduledAt           DateTime?
  executedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  
  outcomes              RecoveryOutcome[]
  executions            RecoveryExecution[]

  @@index([tenantId])
  @@index([opportunityId])
  @@index([status])
  @@index([scheduledAt])
}

model RecoveryOutcome {
  id                    String                @id @default(cuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunityId         String
  opportunity           RecoveryOpportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actionId              String?
  action                RecoveryAction?       @relation(fields: [actionId], references: [id], onDelete: SetNull)
  executionId           String?
  execution             RecoveryExecution?    @relation(fields: [executionId], references: [id], onDelete: SetNull)
  webhookEventId        String?
  webhookEvent          WebhookEvent?         @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)
  
  type                  OutcomeType
  recoveredAmountMinor  Int
  unrecoveredAmountMinor Int                  @default(0)
  currency              String                @default("INR")
  provider              String?
  providerReference     String?
  reason                String?
  details               Json?
  metadata              Json?
  
  occurredAt            DateTime              @default(now())

  @@index([tenantId])
  @@index([opportunityId])
  @@index([actionId])
  @@index([executionId])
  @@index([webhookEventId])
}

model WebhookEvent {
  id                    String                @id @default(cuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  provider              String                
  eventId               String
  eventType             String
  payload               Json
  
  outcomes              RecoveryOutcome[]
  
  processedAt           DateTime?
  createdAt             DateTime              @default(now())

  @@unique([tenantId, provider, eventId])
  @@index([tenantId])
  @@index([createdAt])
}

model RecoveryPolicy {
  id                    String                @id @default(cuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name                  String                @default("Default Recovery Policy")
  enabled               Boolean               @default(true)
  autoExecutionEnabled  Boolean               @default(true)
  
  actionType            ActionType?
  maxAmountMinor        Int                   @default(1000000) // ₹10,000 threshold for automatic execution
  minAmountMinor        Int                   @default(0)
  
  allowedPriorities     PriorityLevel[]       @default([LOW, MEDIUM, HIGH, CRITICAL])
  allowedActions        ActionType[]          @default([RETRY_PAYMENT, SEND_PAYMENT_REMINDER, ESCALATE, CONTACT_CUSTOMER, RECOVER_CHECKOUT, RETRY_SUBSCRIPTION])
  allowedProviders      String[]              @default(["simulation", "resend", "payment_retry"])
  
  maxAttempts           Int                   @default(3)
  cooldownSeconds       Int                   @default(3600) // 1 hour cooldown between attempts
  requiresApproval      Boolean               @default(false)
  
  version               Int                   @default(1)
  createdBy             String?
  updatedBy             String?
  
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([actionType])
  @@index([enabled])
  @@index([autoExecutionEnabled])
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String?
  memberships  Membership[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([email])
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      MembershipRole @default(MEMBER)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

model RecoveryExecution {
  id                    String                @id @default(cuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunityId         String
  opportunity           RecoveryOpportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  recoveryActionId      String
  recoveryAction        RecoveryAction        @relation(fields: [recoveryActionId], references: [id], onDelete: Cascade)

  actionType            ActionType
  provider              String
  status                ExecutionStatus       @default(QUEUED)
  idempotencyKey        String
  attemptCount          Int                   @default(1)
  maxAttempts           Int                   @default(3)
  externalReference     String?
  failureReason         String?
  metadata              Json?

  startedAt             DateTime?
  completedAt           DateTime?
  claimedAt             DateTime?
  claimedBy             String?
  heartbeatAt           DateTime?
  
  requiresReview        Boolean               @default(false)
  errorCategory         String?
  policyVersion         Int?
  
  outcomes              RecoveryOutcome[]
  
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([opportunityId])
  @@index([recoveryActionId])
  @@index([status])
  @@index([claimedAt])
  @@index([requiresReview])
  @@index([errorCategory])
  @@index([createdAt])
}

model AuditEvent {
  id                    String                @id @default(cuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  opportunityId         String?
  opportunity           RecoveryOpportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  actorId               String?
  actorEmail            String?
  actorRole             MembershipRole?
  
  eventType             String
  entityType            String
  entityId              String?
  metadata              Json?

  timestamp             DateTime              @default(now())

  @@index([tenantId])
  @@index([opportunityId])
  @@index([eventType])
  @@index([entityType])
  @@index([timestamp])
}

